#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000 // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 12   // 10

#include <dt-bindings/zmk/mouse.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <300>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    // 上下滚动编码器行为

    scroll_vertical_encoder: scroll_vertical_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    // 左右滚动编码器行为

    scroll_horizontal_encoder: scroll_horizontal_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

        tap-ms = <100>;
    };

    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LCTRL>, <&kp CAPS>;
        };
    };

    combos {
        compatible = "zmk,combos";

        layer4 {
            bindings = <&mo 4>;
            key-positions = <41 42>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&kp TAB     &kp Q      &kp W      &kp E     &kp R  &kp T      &kp Y        &kp U        &kp I      &kp O     &kp P     &kp BSPC
&td0        &kp A      &kp S      &kp D     &kp F  &kp G      &kp H        &kp J        &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHIFT  &kp Z      &kp X      &kp C     &kp V  &kp B      &kp N        &kp M        &kp COMMA  &kp DOT   &kp FSLH  &kp ESC
&mkp LCLK   &mkp MCLK  &mkp RCLK  &kp LGUI  &mo 2  &kp SPACE  &lt 3 ENTER  &lt 1 SPACE  &kp RALT   &mkp MB1  &mo 0     &mo 4
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&scroll_vertical_encoder>;
        };

        num_layers {
            bindings = <
&trans    &kp N1  &kp N2     &kp N3     &kp N4    &kp N5  &kp N6           &kp N7           &kp N8           &kp N9           &kp N0    &kp BSPC
&kp CAPS  &trans  &mkp LCLK  &mkp MCLK  &mkp MB2  &trans  &kp LEFT         &kp DOWN         &kp UP           &kp RIGHT        &kp HOME  &kp PG_UP
&trans    &trans  &trans     &trans     &trans    &trans  &rgb_ug RGB_EFR  &rgb_ug RGB_SPI  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &kp END   &kp PG_DN
&trans    &trans  &trans     &trans     &trans    &trans  &kp INS          &kp DEL          &trans           &trans           &trans    &trans
            >;

            sensor-bindings =
                <&scroll_horizontal_encoder>,
                <&scroll_vertical_encoder>;
        };

        symbo_layers {
            bindings = <
&trans  &kp EXCL      &kp AT        &kp HASH   &kp DLLR   &kp PRCNT  &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR  &kp BSPC
&trans  &trans        &mkp LCLK     &mkp MCLK  &mkp RCLK  &mkp MB4   &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT  &kp BSLH  &kp GRAVE
&trans  &out OUT_USB  &out OUT_BLE  &none      &none      &mkp MB5   &kp UNDER  &kp PLUS   &kp LBRC   &kp RBRC  &kp PIPE  &kp TILDE
&trans  &trans        &trans        &trans     &trans     &kp SPACE  &kp RET    &trans     &trans     &trans    &trans    &trans
            >;

            sensor-bindings =
                <&scroll_horizontal_encoder>,
                <&scroll_vertical_encoder>;
        };

        fn_layer {
            bindings = <
&studio_unlock  &kp F1  &kp F2     &kp F3       &kp F4     &kp F5    &kp F6       &kp F7     &kp F8       &kp F9      &kp F10          &kp F11
&trans          &trans  &mkp LCLK  &mkp MCLK    &mkp RCLK  &mkp MB4  &bootloader  &mkp LCLK  &mkp MCLK    &mkp RCLK   &kp PRINTSCREEN  &kp F12
&trans          &trans  &trans     &bootloader  &trans     &mkp MB5  &trans       &trans     &bootloader  &sys_reset  &kp SCROLLLOCK   &kp PAUSE_BREAK
&trans          &trans  &trans     &trans       &trans     &trans    &trans       &trans     &trans       &trans      &trans           &trans
            >;

            sensor-bindings =
                <&scroll_horizontal_encoder>,
                <&scroll_vertical_encoder>;
        };

        settings-layers {
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans          &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &bt BT_CLR    &bt BT_CLR_ALL  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings =
                <&scroll_horizontal_encoder>,
                <&scroll_vertical_encoder>;
        };
    };
};
